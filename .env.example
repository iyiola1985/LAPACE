# Supabase (Phase B). When set, auth/quotes/admin use the cloud DB.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Comma-separated emails treated as admin in local demo mode
# (Supabase admins use profiles.role = 'admin')
NEXT_PUBLIC_ADMIN_EMAILS=lapaceltd@gmail.com,admin@lapacealuminium.com
